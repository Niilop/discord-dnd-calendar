# Copy to .env and fill in. Never commit .env.

# ── Discord ──────────────────────────────────────────────────────────────
# Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_APPLICATION_ID=
# Optional: register commands to one guild only (instant updates; use for development).
DISCORD_DEV_GUILD_ID=
# Optional: Discord user IDs (comma-separated) with full access on every server the
# bot is in, like server admins. Discord → Settings → Advanced → Developer Mode,
# then right-click a name → Copy User ID.
BOT_ADMIN_USER_IDS=

# ── Database ─────────────────────────────────────────────────────────────
# Used by docker-compose for the postgres service and the bot's DATABASE_URL.
# Use a URL-safe value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Only needed when running the bot outside Docker (npm run dev):
# DATABASE_URL=postgres://dnd:<POSTGRES_PASSWORD>@localhost:5433/dnd_calendar

# ── App ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# SCHEDULER_INTERVAL_SECONDS=60
# HEALTH_PORT=8080

# ── Backups (read by scripts/backup.sh on the server) ────────────────────
# BACKUP_DIR=/var/backups/dnd-calendar
# BACKUP_RETENTION_DAYS=14
# Off-server copy via rclone (strongly recommended), e.g. a Hetzner Storage Box
# configured as an rclone "sftp" remote, optionally wrapped in a "crypt" remote:
# BACKUP_RCLONE_REMOTE=storagebox-crypt:dnd-calendar
# BACKUP_RCLONE_RETENTION_DAYS=60
