{
  "name": "discord-dnd-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-native D&D campaign scheduling bot",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "register-commands": "node dist/scripts/registerCommands.js",
    "register-commands:dev": "tsx --env-file-if-exists=.env src/scripts/registerCommands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
